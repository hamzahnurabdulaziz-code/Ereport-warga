# Version control
.git
.gitignore
.gitattributes

# Environment files and credentials
.env
.env.*
!.env.example

# Composer
/vendor

# Node & Package Managers
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Static asset build (rebuilt cleanly in Docker multi-stage frontend build)
/public/build
/public/hot
/public/storage

# Storage, logs, and cache
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/app/public/*
/storage/*.key
/storage/pail

# Caches & temporary files
.phpunit.cache
.phpunit.result.cache
.phpactor.json

# IDE / Editor files
.idea
.vscode
.cursor
.zed
.claude
.agents
*.log
Thumbs.db
.DS_Store
